---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.project_key %}
      {% include project_authors.liquid project_key=page.project_key %}
    {% endif %}
    {% if page.description and page.hide_description != true %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>
</div>
