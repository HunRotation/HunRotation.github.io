---
layout: default
---
<style>
  .research-interests {
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hashtag {
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.9rem;
    font-weight: bold;
    display: inline-block;
    /* Light mode styles */
    background-color: #e9ecef; /* Bright gray background */
    color: #212529; /* Dark text */
  }
  /* Dark mode styles */
  html.dark .hashtag {
    background-color: #343a40; /* Dark background */
    color: #f8f9fa; /* Bright text */
  }
</style>
<div class="post">
  {% if page.profile %}
    <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
      {% if page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% if page.profile.image_circular %}
          {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
        {% else %}
          {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
        {% endif %}
        {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.10}}px, (min-width: 576px)
      15vw, 45vw"{% endcapture %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
          cache_bust=true
        %}
      {% endif %}
    </div>
  {% endif %}

  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {{ site.first_name }}
        {{ site.middle_name }}
        <span class="font-weight-bold">{{ site.last_name }}</span>
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <div class="contact-info" style="margin-bottom: 1rem;">
      {% if site.data.socials.address %}
        <p style="margin-bottom: 0.5rem;"><i class="fa-solid fa-location-dot" style="margin-right: 0.5rem;"></i>{{ site.data.socials.address }}</p>
      {% endif %}
      {% if site.data.socials.phone %}
        <p style="margin-bottom: 0.5rem;"><i class="fa-solid fa-phone" style="margin-right: 0.5rem;"></i>{{ site.data.socials.phone }}</p>
      {% endif %}
      {% if site.data.socials.email %}
        <p style="margin-bottom: 0.5rem;">
          <i class="fa-solid fa-envelope" style="margin-right: 0.5rem;"></i
          ><a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
        </p>
      {% endif %}
    </div>
    <div class="social-icons" style="margin-bottom: 2rem;">
      {% if site.data.socials.github_username %}
        <a href="https://github.com/{{ site.data.socials.github_username }}" title="GitHub" style="margin-right: 0.5rem;"
          ><i class="fa-brands fa-github fa-2x"></i
        ></a>
      {% endif %}
      {% if site.data.socials.linkedin_username %}
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" title="LinkedIn"
          ><i class="fa-brands fa-linkedin fa-2x"></i
        ></a>
      {% endif %}
    </div>
    <div class="research-interests">
      {% if site.research_interests %}
        {% for interest in site.research_interests %}
          <span class="hashtag"># {{ interest }}</span>
        {% endfor %}
      {% endif %}
    </div>
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
