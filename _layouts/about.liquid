---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
     <div style="display: flex; align-items: center;">
        {% if site.title == 'blank' %}
          {{ site.first_name }}
          {{ site.middle_name }}
          <span class="font-weight-bold">{{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.10}}px, (min-width: 576px)
          15vw, 45vw"{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image style="margin-left: 1rem;" cache_bust=true %}
        {% endif %}
      </div>

      {% endif %}
    </h1>
    <div class="contact-info" style="margin-bottom: 1rem;">
      {% if site.data.socials.address %}
        <p style="margin-bottom: 0.5rem;"><i class="fa-solid fa-location-dot" style="margin-right: 0.5rem;"></i>{{ site.data.socials.address }}</p>
      {% endif %}
      {% if site.data.socials.phone %}
        <p style="margin-bottom: 0.5rem;"><i class="fa-solid fa-phone" style="margin-right: 0.5rem;"></i>{{ site.data.socials.phone }}</p>
      {% endif %}
      {% if site.data.socials.email %}
        <p style="margin-bottom: 0.5rem;">
          <i class="fa-solid fa-envelope" style="margin-right: 0.5rem;"></i
          ><a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
        </p>
      {% endif %}
    </div>
    <div class="social-icons" style="margin-bottom: 2rem;">

  </header>

  <article>

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}

      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}

      {% include latest_posts.liquid %}
    {% endif %}


      {% if site.data.socials.github_username %}
        <a href="https://github.com/{{ site.data.socials.github_username }}" title="GitHub" style="margin-right: 0.5rem;"
          ><i class="fa-brands fa-github fa-2x" style="color: white;"></i
        ></a>
      {% endif %}
      {% if site.data.socials.linkedin_username %}
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" title="LinkedIn"
          ><i class="fa-brands fa-linkedin fa-2x" style="color: white;"></i
        ></a>
      {% endif %}
    </div>
  </header>

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
