{% for award in data[1] %}
  <div class="row">
    <div class="col-sm-9">
      <h6 class="title font-weight-bold">{{ award.title }}</h6>
      <p class="awarder mb-1">{{ award.awarder }}</p>
      {% if award.summary and award.summary != '' %}
        <p class="summary text-muted mb-0">{{ award.summary }}</p>
      {% endif %}
    </div>
    <div class="col-sm-3 text-sm-right">
      <p class="date">{{ award.date | date: '%B %Y' }}</p>
    </div>
  </div>
  {% unless forloop.last %}<hr class="mt-3 mb-3">{% endunless %}
{% endfor %}
