<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.releaseDate %} {% assign date = content.releaseDate | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}">{{ content.name }}</a>
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic;">
            {% for author in content.authors %}
                {% if author == "Gyehun Go" %}<strong>{{ author }}</strong>{% else %}{{ author }}{% endif %}{% unless forloop.last %}, {% endunless %}
            {% endfor %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.publisher }}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <div class="links ml-1 ml-md-4">
            {% if content.paper %}
              <a href="{{ content.paper }}" class="btn z-depth-0" role="button" target="_blank" rel="noopener noreferrer"
                ><i class="fa-solid fa-file-lines" style="margin-right: 0.5rem;"></i>Paper</a
              >
            {% endif %}
            {% if content.code %}
              <a href="{{ content.code }}" class="btn z-depth-0" role="button" target="_blank" rel="noopener noreferrer"
                ><i class="fa-brands fa-github" style="margin-right: 0.5rem;"></i>Code</a
              >
            {% endif %}
            {% if content.demo %}
              <a href="{{ content.demo }}" class="btn z-depth-0" role="button" target="_blank" rel="noopener noreferrer"
                ><i class="fa-solid fa-play-circle" style="margin-right: 0.5rem;"></i>Demo</a
              >
            {% endif %}
          </div>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
